{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static-assets-only Worker serving the `next build` export in ./out.
  "name": "petorose-alcones",
  "account_id": "286ca12827a1a42e9edbf03ec5c70479",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
